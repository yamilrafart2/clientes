# =============================================================================
# 1. GRADLE & BUILD OUTPUTS (Unidad 1)
# Excluye artefactos compilados, reportes de JaCoCo y cachés de Gradle
# =============================================================================
.gradle/
build/
out/
bin/
.kotlin/

# Regla de inclusión explícita (!): Mantener el Wrapper para portabilidad de build
!gradle/wrapper/gradle-wrapper.jar

# =============================================================================
# 2. CONFIGURACIÓN DE IDEs (IntelliJ IDEA, Eclipse, VS Code)
# Previene conflictos de configuración entre integrantes del equipo
# =============================================================================
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/
.springBeans
.sts4-cache/

# =============================================================================
# 3. ARCHIVOS DEL SISTEMA OPERATIVO Y LOGS
# =============================================================================
.DS_Store
Thumbs.db
*.log